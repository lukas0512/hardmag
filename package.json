    "preview": "node src/run.ts --dry --count 4",
    "brand": "node src/brand.ts",
    "refresh-token": "node src/refresh-token.ts",
    "typecheck": "tsc --noEmit",
    "ig-check": "node src/ig-check.ts",
    "ig-setup": "node src/ig-setup.ts",
    "claude-setup": "node src/claude-setup.ts",
    "report": "node src/insights.ts",
    "plan": "node src/plan.ts",
    "prepare-slot": "node src/run.ts --prepare",
    "publish-due": "node src/publish-due.ts",
    "queue": "node src/queue-status.ts",
    "grid": "node src/grid.ts",
    "telegram-setup": "node src/telegram-setup.ts",
    "handoff-test": "node src/handoff.ts --test"
  },
  "dependencies": {
    "image-size": "^2.1.0",
    "playwright": "^1.65.1",
