{
  "name": "hardmag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HARDMAG — automated techno & house news on Instagram",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "run": "node src/run.ts",
