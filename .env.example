# Copy to .env for local runs. On GitHub these go in Settings → Secrets and variables → Actions.

# Claude writes the posts through Claude Code on your Claude subscription (no API key).
# Locally: nothing to set, it uses the Claude Code you are logged into.
# GitHub Actions: run `claude setup-token` and save the token as the CLAUDE_CODE_OAUTH_TOKEN secret.

# Instagram API with Instagram Login (see docs/ATIVACAO.md)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Public image hosting: a PUBLIC GitHub repo "owner/repo" + a token that can write to it
MEDIA_REPO=
GITHUB_TOKEN=

# Optional
BRAND_HANDLE=@hardmag.news
POSTS_PER_RUN=1
MAX_AGE_HOURS=48
